# Copy this to .env.local and edit values for your machine.

# Where the SQLite registry lives. Default: ~/.agent-dashboard/agents.db
# Override if you want to keep an existing database elsewhere.
# AGENT_DB_PATH=/Users/you/.agent-dashboard/agents.db

# Source directory for the skill catalog used by the scaffolder.
# This points at a `.claude/skills/` directory whose entries (each containing
# a SKILL.md) will be offered when scaffolding a new agent.
# Leave unset to disable skill scaffolding.
# SKILLS_SOURCE_DIR=/path/to/your/.claude/skills

# Absolute path to the agent directory the Telegram bot speaks for.
# No default: pointing this at the wrong tree would let the bot answer as
# an agent that is not the one you meant.
AGENT_DIR=
